    "オンはグループごとに色が変わり、オフは全部が同じ色になります": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンはグループごとに色が変わり、オフは全部が同じ色になります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: each group gets its own color. Off: everything is one color."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时每组颜色不同，关闭时全部同一种颜色"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時每組顏色不同，關閉時全部同一種顏色"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 그룹마다 색이 바뀌고, 끄면 모두 같은 색이 됩니다"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: cada grupo tiene su color. Desactivado: todo en un solo color."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé : une couleur par groupe. Désactivé : tout de la même couleur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An: jede Gruppe hat eine eigene Farbe. Aus: alles in einer Farbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato: ogni gruppo ha il suo colore. Disattivato: tutto dello stesso colore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado: cada grupo tem sua cor. Desativado: tudo numa só cor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл.: у каждой группы свой цвет. Выкл.: всё одного цвета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التشغيل يكون لكل مجموعة لون، وعند الإيقاف يصبح الكل بلون واحد"
          }
        }
      }
    },
