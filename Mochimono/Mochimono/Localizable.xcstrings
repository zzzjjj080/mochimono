    "%lld 回も奢ってくれてありがとうございました": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回も奢ってくれてありがとうございました"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for %lld coffees!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你请了 %lld 杯咖啡！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝你請了 %lld 杯咖啡！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커피를 %lld번이나 사 주셔서 감사합니다!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por %lld cafés!"
          }
        },
        "fr": {
          "stringUnit": {
