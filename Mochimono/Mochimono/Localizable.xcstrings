    "「%@」と、書いた %lld個の持ち物がすべて消えます。元に戻せません。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と、書いた %lld個の持ち物がすべて消えます。元に戻せません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and its %lld items will be deleted. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其中的 %lld 项将全部删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」及其中的 %lld 項將全部刪除。此操作無法復原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’와 항목 %lld개가 모두 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán «%@» y sus %lld elementos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et ses %lld éléments seront supprimés. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und die %lld Einträge werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» e le sue %lld voci verranno eliminati. L'azione non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e seus %lld itens serão apagados. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и все пункты (%lld) будут удалены. Это нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف «%@» وعناصرها (%lld). لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
