    "%lld個中 %lld個に付いているチェックが、すべて外れます。元に戻せません。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld個中 %lld個に付いているチェックが、すべて外れます。元に戻せません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All checks on %2$lld of %1$lld items will be removed. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 项中已勾选的 %2$lld 项将全部取消。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 項中已勾選的 %2$lld 項將全部取消。此操作無法復原。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld개 중 %2$lld개에 표시된 체크가 모두 해제됩니다. 되돌릴 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitarán las marcas de %2$lld de %1$lld elementos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coches de %2$lld éléments sur %1$lld seront retirées. Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Haken bei %2$lld von %1$lld Einträgen werden entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno tolte le spunte da %2$lld voci su %1$lld. L'azione non si può annullare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As marcas de %2$lld de %1$lld itens serão removidas. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметки с %2$lld из %1$lld пунктов будут сняты. Это нельзя отменить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة العلامات من %2$lld من أصل %1$lld عناصر. لا يمكن التراجع عن ذلك."
          }
        }
      }
    },
