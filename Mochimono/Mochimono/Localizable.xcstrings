    "まだの物を順に読み上げます。「持った」と答えると印が付きます": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだの物を順に読み上げます。「持った」と答えると印が付きます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the unchecked items one by one. Say “got it” to check one off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依次朗读未勾选的项目。回答“好了”即可勾选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序朗讀未勾選的項目。回答「好了」即可勾選。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크하지 않은 항목을 차례로 읽어 줍니다. “됐어”라고 답하면 체크됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee uno a uno los elementos sin marcar. Di «listo» para marcarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un à un les éléments non cochés. Dites « c’est bon » pour cocher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die offenen Einträge nacheinander vor. Sag „hab ich“, um abzuhaken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge una alla volta le voci non spuntate. Di’ «fatto» per spuntarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê um a um os itens não marcados. Diga “peguei” para marcar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По очереди читает неотмеченные пункты. Скажите «взял», чтобы отметить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ العناصر غير المحددة واحدًا تلو الآخر. قل «تمام» لتحديد العنصر."
          }
        }
      }
    },
    "まだ何も入っていません。\n下の「編集」から書けます。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も入っていません。\n下の「編集」から書けます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
