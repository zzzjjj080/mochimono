    "右上の「＋」から、旅行や通勤などの雛形を選んで作れます。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の「＋」から、旅行や通勤などの雛形を選んで作れます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “+” at the top to start from a template like travel or commute."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点顶部的“+”，可以从旅行、通勤等模板开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點上方的「+」，可以從旅行、通勤等範本開始。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위쪽의 ‘+’에서 여행·출근 같은 템플릿을 골라 만들 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «+» arriba para empezar con una plantilla, como viaje o trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez « + » en haut pour partir d'un modèle (voyage, trajet…)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben auf „+“, um mit einer Vorlage wie Reise oder Pendeln zu starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «+» in alto per partire da un modello, come viaggio o lavoro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “+” lá em cima para começar com um modelo, como viagem ou trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «+» вверху, чтобы начать с шаблона — например, поездка или дорога на работу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط «+» في الأعلى لتبدأ من قالب مثل السفر أو الذهاب للعمل."
          }
        }
      }
    },
    "声で「持った」「次」「もう一回」「止めて」と答えられます": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声で「持った」「次」「もう一回」「止めて」と答えられます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer by voice: “got it”, “next”, “again”, or “stop”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用语音回答：“好了”“下一个”“再说一遍”“停”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以用語音回答：「好了」「下一個」「再說一遍」「停」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“됐어”, “다음”, “다시”, “그만”이라고 말로 답할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde con la voz: «listo», «siguiente», «otra vez» o «para»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez à voix haute : « c’est bon », « suivant », « répète » ou « stop »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte per Stimme: „hab ich“, „weiter“, „nochmal“ oder „stopp“."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a voce: «fatto», «avanti», «ripeti» o «basta»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda por voz: “peguei”, “próximo”, “repete” ou “para”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечайте голосом: «взял», «дальше», «повтори» или «стоп»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجب بصوتك: «تمام» أو «التالي» أو «كرر» أو «توقف»."
          }
        }
      }
    },
    "声で答えるには、設定でマイクと音声認識を許可してください": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声で答えるには、設定でマイクと音声認識を許可してください"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To answer by voice, allow Microphone and Speech Recognition in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要用语音回答，请在“设置”中允许麦克风和语音识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要用語音回答，請在「設定」中允許麥克風和語音辨識。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말로 답하려면 설정에서 마이크와 음성 인식을 허용하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder con la voz, permite el micrófono y el reconocimiento de voz en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour répondre à voix haute, autorisez le micro et la reconnaissance vocale dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um per Stimme zu antworten, erlaube Mikrofon und Spracherkennung in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rispondere a voce, consenti microfono e riconoscimento vocale in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder por voz, permita o microfone e o reconhecimento de fala nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отвечать голосом, разрешите микрофон и распознавание речи в Настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإجابة بصوتك، اسمح بالميكروفون والتعرّف على الكلام في الإعدادات."
          }
        }
      }
    },
