    "選ぶとコピーが作られます。要らない行を消して、自分用に書き換えてください。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選ぶとコピーが作られます。要らない行を消して、自分用に書き換えてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picking one makes a copy. Delete the lines you don't need and make it yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后会生成副本。删掉不需要的行，改成你自己的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇後會建立副本。刪掉不需要的行，改成自己的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고르면 사본이 만들어집니다. 필요 없는 줄을 지우고 내 것으로 고쳐 쓰세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al elegir una se crea una copia. Borra lo que no necesites y hazla tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un modèle en crée une copie. Supprimez les lignes inutiles et adaptez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Auswählen entsteht eine Kopie. Lösche, was du nicht brauchst, und pass sie an."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliendone uno se ne crea una copia. Cancella le righe che non servono e personalizzala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao escolher, é criada uma cópia. Apague o que não precisa e deixe do seu jeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выборе создаётся копия. Удалите лишние строки и подстройте под себя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الاختيار تُنشأ نسخة. احذف ما لا تحتاجه وعدّلها لتناسبك."
          }
        }
      }
    },
