{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Tilecheck reads your list aloud, you can answer “got it” or “next” by voice. Your voice is recognized on this iPhone and never sent anywhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げ中に「持った」「次」と声で答えられるようにするために使います。声はこのiPhoneの中だけで聞き取り、外へは送りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读清单时，你可以用语音回答“好了”或“下一个”。语音只在这台 iPhone 上识别，不会发送到任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朗讀清單時，你可以用語音回答「好了」或「下一個」。語音只在這台 iPhone 上辨識，不會傳送到任何地方。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 읽어 주는 동안 “됐어”, “다음”이라고 말로 답할 수 있게 하려고 사용합니다. 음성은 이 iPhone 안에서만 인식하며 외부로 보내지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras Tilecheck lee tu lista, puedes responder «listo» o «siguiente» con la voz. Tu voz se reconoce en este iPhone y nunca se envía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que Tilecheck lit votre liste, vous pouvez répondre « c’est bon » ou « suivant » à voix haute. Votre voix est reconnue sur cet iPhone et n’est jamais envoyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während Tilecheck deine Liste vorliest, kannst du per Stimme mit „hab ich“ oder „weiter“ antworten. Deine Stimme wird auf diesem iPhone erkannt und nirgendwohin gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre Tilecheck legge la tua lista, puoi rispondere a voce «fatto» o «avanti». La voce viene riconosciuta su questo iPhone e non viene mai inviata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto o Tilecheck lê sua lista, você pode responder “peguei” ou “próximo” por voz. Sua voz é reconhecida neste iPhone e nunca é enviada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока Tilecheck читает список, можно отвечать голосом: «взял» или «дальше». Голос распознаётся на этом iPhone и никуда не отправляется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء قراءة Tilecheck لقائمتك، يمكنك الإجابة بصوتك «تمام» أو «التالي». يتم التعرّف على صوتك على هذا الـ iPhone ولا يُرسل إلى أي مكان."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecheck recognizes your answers (“got it”, “next”, “stop”) on this iPhone while it reads your list aloud. Nothing is sent anywhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げ中の答え（「持った」「次」「止めて」）を、このiPhoneの中だけで聞き取ります。外へは何も送りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "朗读清单时，Tilecheck 会在这台 iPhone 上识别你的回答（“好了”“下一个”“停”）。不会发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朗讀清單時，Tilecheck 會在這台 iPhone 上辨識你的回答（「好了」「下一個」「停」）。不會傳送任何內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록을 읽어 주는 동안 답(“됐어”, “다음”, “그만”)을 이 iPhone 안에서만 인식합니다. 외부로 아무것도 보내지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecheck reconoce tus respuestas («listo», «siguiente», «para») en este iPhone mientras lee tu lista. No se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecheck reconnaît vos réponses (« c’est bon », « suivant », « stop ») sur cet iPhone pendant la lecture. Rien n’est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecheck erkennt deine Antworten („hab ich“, „weiter“, „stopp“) auf diesem iPhone, während es vorliest. Es wird nichts gesendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilecheck riconosce le tue risposte («fatto», «avanti», «basta») su questo iPhone mentre legge la lista. Non viene inviato nulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tilecheck reconhece suas respostas (“peguei”, “próximo”, “para”) neste iPhone enquanto lê a lista. Nada é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока Tilecheck читает список, он распознаёт ваши ответы («взял», «дальше», «стоп») на этом iPhone. Ничего не отправляется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعرّف Tilecheck على إجاباتك («تمام»، «التالي»، «توقف») على هذا الـ iPhone أثناء القراءة. لا يُرسل أي شيء."
          }
        }
      }
    }
  }
}